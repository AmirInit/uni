{
  "name": "shop-site-js",
  "version": "1.0.0",
  "private": true,
  "description": "فروشگاه آنلاین — a full-stack Persian (RTL) e-commerce app: React + Vite frontend, Express + SQLite REST API.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm install && npm run seed",
    "seed": "npm run seed --workspace server",
    "seed:reset": "npm run seed:reset --workspace server",
    "dev": "concurrently -k -n \"API,WEB\" -c \"cyan,magenta\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
