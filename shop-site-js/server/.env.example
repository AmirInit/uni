# ------------------------------------------------------------------
# Copy this file to `.env` and adjust if needed.
#   cp .env.example .env
# The server also boots with sane defaults if `.env` is missing.
# ------------------------------------------------------------------

# Port the Express API listens on.
PORT=5000

# Environment: development | production
NODE_ENV=development

# Secret used to sign JWT access tokens.
# Change this to a long random string before any real deployment.
JWT_SECRET=change-me-to-a-long-random-secret-string

# How long an issued token stays valid (zeit/ms format: 7d, 12h, 30m ...)
JWT_EXPIRES_IN=7d

# Path to the SQLite database file, relative to the `server/` folder.
DATABASE_FILE=./data/shop.db

# Comma separated list of origins allowed to call the API (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
